# Private inputs and generated output: never publish these.
/xnu-src/
/xnu-build.log
/hakios-kernel
/.config
/private/
/loader/out/
__pycache__/
*.pyc
*.log
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.ipa
*.ipsw
*.dmg
*.img
*.img4
*.im4p
*.apfs
*.bin
*.fw
*.mdt
*.mbn
*.b[0-9][0-9]
*.dtb
*.dtbo
*.dylib
*.o
*.a
# Keep only versioned dependency bootstrap sources.
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/lzbitmap/
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
